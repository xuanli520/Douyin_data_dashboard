APP__NAME=fastapi-boilerplate
APP__VERSION=0.1.0
APP__DEBUG=false
APP__HOST=0.0.0.0
APP__PORT=8000
APP__TIMEZONE=8

LOG__LEVEL=INFO
LOG__JSON_LOGS=false

DB__DRIVER=postgresql
DB__HOST=db
DB__PORT=5432
DB__USER=postgres
DB__PASSWORD=postgres
DB__DATABASE=appdb

CACHE__BACKEND=redis
CACHE__HOST=redis
CACHE__PORT=6379
CACHE__DB=0
CACHE__PASSWORD=
CACHE__ENCODING=utf-8

AUTH__JWT_SECRET=my-secret-key-is-purplevoid
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_LIFETIME_SECONDS=1800
AUTH__REFRESH_TOKEN_LIFETIME_SECONDS=2592000

AUTH__OAUTH_GOOGLE_CLIENT_ID=
AUTH__OAUTH_GOOGLE_CLIENT_SECRET=
AUTH__OAUTH_GITHUB_CLIENT_ID=
AUTH__OAUTH_GITHUB_CLIENT_SECRET=

CAPTCHA__ENABLED=false
